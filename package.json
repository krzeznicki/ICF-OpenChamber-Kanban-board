{
  "name": "icf-kanban",
  "version": "0.3.8",
  "description": "Kanban Board: an OpenChamber extension with a Kanban board over local .scratch/ files or GitHub Issues",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/panel",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build-test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.1",
    "markdown-it": "14.3.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "panel": {
        "id": "icf-kanban",
        "name": "Kanban Board",
        "icon": "assets/kanban.svg",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/page.html",
        "title": "Kanban Board"
      },
      "commands": [
        {
          "name": "kanban",
          "description": "Open the Kanban Board panel"
        }
      ],
      "capabilities": [
        "sessions",
        "prompt",
        "model"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "git",
            "gh",
            "opencode"
          ]
        }
      },
      "sessionControl": {},
      "sessionEvents": {
        "events": [
          "turn-finished",
          "turn-failed"
        ]
      },
      "instructions": true,
      "skills": "skills"
    }
  }
}
